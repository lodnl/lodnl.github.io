% resume.sty -- layout of the CV. Content lives in cv.tex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}[2026/10/10 Simple one-column resume layout]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[a4paper,left=1.6cm,right=1.6cm,top=1.2cm,bottom=1.2cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage[hidelinks]{hyperref}

\definecolor{accent}{HTML}{1F3A5F}
\definecolor{muted}{HTML}{555555}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.07}

% Section headings: uppercase bold with a rule underneath
\titleformat{\section}
  {\large\bfseries\color{accent}}
  {}{0pt}{\MakeUppercase}[\vspace{1pt}{\color{accent}\titlerule[0.6pt]}]
\titlespacing*{\section}{0pt}{12pt}{6pt}

% Bullet lists
\setlist[itemize]{leftmargin=1.1em, label={\color{accent}\textbullet}, itemsep=2pt, topsep=3pt, parsep=0pt, partopsep=0pt}

% \cvheader{Name}{Title}{contact line}
\newcommand{\cvheader}[3]{%
  \begin{center}
    {\Huge\bfseries\color{accent}#1}\\[3pt]
    {\large #2}\\[4pt]
    {\small\color{muted}#3}
  \end{center}
  \vspace{-4pt}}

% \entry{Title}{Dates}{Organisation}{Location}
\newcommand{\entry}[4]{%
  \par\noindent
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1} & {\small\color{muted}#2}\\
    \textit{#3} & {\small\color{muted}\textit{#4}}
  \end{tabularx}\par\vspace{1pt}}

% \subentry{Role}{Dates}: a role inside a larger entry
\newcommand{\subentry}[2]{%
  \par\vspace{3pt}\noindent{\small\textsc{#1}}\hfill{\small\color{muted}#2}\par}

% \skill{Label}{Content}
\newcommand{\skill}[2]{%
  \par\noindent\begin{tabularx}{\linewidth}{@{}p{3.6cm} >{\raggedright\arraybackslash}X@{}}
    \textbf{#1} & #2
  \end{tabularx}\par\vspace{1pt}}

\newcommand{\entrygap}{\vspace{8pt}}

